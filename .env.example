# Copy this file to .env.local. Leave database credentials blank to browse demo data.
MONGODB_URI=
MONGODB_DB=yalla_market_demo

# Image uploads need an ImageKit private key and your account's HTTPS endpoint.
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=

ADMIN_EMAIL=admin@example.invalid
ADMIN_PASSWORD_HASH=
SESSION_SECRET=

# Public contact settings are embedded in the client bundle during build.
# WhatsApp: international digits only. Payment phone: the displayed recipient.
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_PAYMENT_PHONE=
NEXT_PUBLIC_STORE_NAME=Yalla Market
NEXT_PUBLIC_DEMO_CATALOG=true
NEXT_PUBLIC_SITE_URL=http://localhost:3000
SITE_URL=http://localhost:3000
